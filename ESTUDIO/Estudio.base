filters:
  and:
    - file.inFolder("ESTUDIO")
    - file.ext == "md"
formulas:
  updated_label: if(updated, date(updated).format("YYYY-MM-DD"), file.mtime.format("YYYY-MM-DD"))
  kind: if(file.folder.contains("METODOS"), "metodo", "hub")
properties:
  title:
    displayName: Titulo
  formula.kind:
    displayName: Tipo
  formula.updated_label:
    displayName: Actualizado
  status:
    displayName: Estado
views:
  - type: table
    name: Metodos
    filters:
      and:
        - file.inFolder("ESTUDIO/METODOS")
    order:
      - file.name
      - title
      - formula.updated_label
      - tags
  - type: table
    name: Todo ESTUDIO
    order:
      - file.name
      - formula.kind
      - status
      - formula.updated_label
